# Empty is valid for the unconnected bootstrap shell.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; not required by MGBOS-001.
SUPABASE_SERVICE_ROLE_KEY=
MGBOS_APP_URL=http://localhost:3101
TEESTOCK_APP_URL=http://localhost:3102

# Optional official WhatsApp business contact number in international format (digits only, e.g. 628xxxxxxxxxx).
# If unset or invalid, customer WhatsApp action links safely fail closed to a disabled/unavailable state.
NEXT_PUBLIC_WHATSAPP_NUMBER=
