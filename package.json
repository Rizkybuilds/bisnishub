{
  "name": "bisnishub",
  "version": "1.0.0",
  "private": true,
  "description": "BisnisHub Monorepo & TeeStock Apparel Platform",
  "scripts": {
    "build": "npm --prefix bisnis/teestock/web run build",
    "dev": "npm --prefix bisnis/teestock/web run dev",
    "dev:teestock": "npm --prefix bisnis/teestock/web run dev",
    "build:teestock": "npm --prefix bisnis/teestock/web run build",
    "dev:bisnishub": "npm --prefix apps/bisnishub-web run dev",
    "build:bisnishub": "npm --prefix apps/bisnishub-web run build",
    "dev:mgbos": "npm exec --yes --package=pnpm@10.34.5 -- pnpm --dir mgbos dev",
    "build:mgbos": "npm exec --yes --package=pnpm@10.34.5 -- pnpm --dir mgbos build",
    "install:mgbos": "npm exec --yes --package=pnpm@10.34.5 -- pnpm --dir mgbos install --frozen-lockfile",
    "install:all": "npm run install:legacy && npm run install:mgbos",
    "dev:mgbos-prototype": "npm --prefix apps/mgbos run dev",
    "build:mgbos-prototype": "npm --prefix apps/mgbos run build",
    "install:mgbos-prototype": "npm --prefix apps/mgbos install",
    "dev:mgbos:teestock": "npm exec --yes --package=pnpm@10.34.5 -- pnpm --dir mgbos dev:teestock",
    "check:mgbos": "npm exec --yes --package=pnpm@10.34.5 -- pnpm --dir mgbos check",
    "install:legacy": "npm --prefix bisnis/teestock/web install && npm --prefix apps/bisnishub-web install && npm --prefix apps/mgbos install"
  }
}
