{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bisnishub://engineering/verification-matrix.schema.json",
  "title": "BisnisHub Verification Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "implementation_contract_id",
    "verified_revision",
    "verifier",
    "environment",
    "cases",
    "overall_status",
    "unverified_gates",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "VERIFICATION_MATRIX"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^VM-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "implementation_contract_id": {
      "type": "string",
      "pattern": "^IC-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "verified_revision": {
      "type": "string",
      "minLength": 7
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity"],
      "properties": {
        "role": {
          "const": "qa"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": ["string", "null"]
        },
        "provider": {
          "type": ["string", "null"]
        }
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "overall_status": {
      "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL", "NOT_RUN"]
    },
    "unverified_gates": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to_roles", "allowed_next_action"],
      "properties": {
        "to_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["engineer", "release-operator"]
          }
        },
        "allowed_next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "acceptance_criterion_ids",
        "description",
        "procedure",
        "result",
        "observed",
        "timestamp"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^VC-[0-9]{3,}$"
        },
        "acceptance_criterion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AC-[0-9]{3,}$"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_reference": {
          "type": ["string", "null"]
        },
        "limitations": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
