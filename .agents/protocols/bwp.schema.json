{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bisnishub.invalid/protocols/bwp.schema.json",
  "title": "ATLAS Bounded Work Package (BWP) Dispatch Schema",
  "description": "Schema for ATLAS Head Engineering bounded work package delegation to AI builders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_package_id",
    "feasibility_ref",
    "target_workspace",
    "builder_runtime",
    "active_canonical_role",
    "base_revision_sha",
    "isolated_branch",
    "effective_risk_floor",
    "bounded_file_scope",
    "required_checks",
    "stop_conditions"
  ],
  "properties": {
    "work_package_id": {
      "type": "string",
      "pattern": "^BWP-[0-9]{8}-[0-9]{2,}$"
    },
    "feasibility_ref": {
      "type": "string",
      "pattern": "^TFC-[0-9]{8}-[0-9]{2,}$"
    },
    "target_workspace": {
      "type": "string"
    },
    "builder_runtime": {
      "type": "string",
      "enum": ["antigravity", "codex", "claude"]
    },
    "active_canonical_role": {
      "type": "string",
      "enum": ["engineer"]
    },
    "base_revision_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "isolated_branch": {
      "type": "string"
    },
    "isolated_worktree": {
      "type": "string"
    },
    "effective_risk_floor": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3", "R4", "R5"]
    },
    "bounded_file_scope": {
      "type": "object",
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  }
}
