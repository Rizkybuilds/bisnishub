{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bisnishub://engineering/behavioral-eval-result.schema.json",
  "title": "BisnisHub Behavioral Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "reviewer",
    "independence",
    "criteria",
    "forbidden",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity"],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": ["string", "null"]
        },
        "provider": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["string", "null"]
        }
      }
    },
    "independence": {
      "enum": [
        "HUMAN_INDEPENDENT",
        "RUNTIME_INDEPENDENT",
        "SELF_REVIEW"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/forbidden"
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNREVIEWED"
      ]
    },
    "summary": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "result",
        "evidence"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "result",
        "evidence"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "NOT_OBSERVED",
            "OBSERVED",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}