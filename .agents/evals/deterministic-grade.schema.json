{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bisnishub://engineering/deterministic-grade.schema.json",
  "title": "BisnisHub Deterministic Behavioral Grade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "runtime",
    "grader",
    "observability",
    "checks",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "enum": ["codex", "antigravity"]
    },
    "grader": {
      "const": "bisnishub-deterministic-v1"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "commands"
      ],
      "properties": {
        "filesystem": {
          "enum": ["AVAILABLE", "UNAVAILABLE"]
        },
        "commands": {
          "enum": [
            "STRUCTURED",
            "TEXT_ONLY",
            "UNAVAILABLE",
            "BROKEN"
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "result",
        "required_for_pass",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "required_for_pass": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}