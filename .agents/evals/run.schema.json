{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bisnishub://engineering/behavioral-eval-run.schema.json",
  "title": "BisnisHub Behavioral Evaluation Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "runtime",
    "provider",
    "repository_revision",
    "configuration_fingerprint",
    "started_at",
    "finished_at",
    "execution_status",
    "exit_code",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "enum": ["codex", "antigravity"]
    },
    "provider": {
      "enum": ["OpenAI", "Google"]
    },
    "runtime_version": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "repository_revision": {
      "type": "string",
      "minLength": 7
    },
    "configuration_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "TIMED_OUT"
      ]
    },
    "exit_code": {
      "type": ["integer", "null"]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_prompt",
        "stdout",
        "stderr",
        "git_status_before",
        "git_status_after",
        "git_diff_after"
      ],
      "properties": {
        "candidate_prompt": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "provider_log": {
          "type": ["string", "null"]
        },
        "git_status_before": {
          "type": "string"
        },
        "git_status_after": {
          "type": "string"
        },
        "git_diff_after": {
          "type": "string"
        }
      }
    }
  }
}