{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bisnishub://engineering/preflight-decision.schema.json",
  "title": "BisnisHub Engineering Action Preflight Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "reason_code",
    "principal_id",
    "principal_attestation_ref",
    "role",
    "capability",
    "role_grant_state",
    "environment",
    "declared_risk",
    "effective_risk",
    "risk_adjusted",
    "minimum_autonomy",
    "autonomy_ceiling",
    "current_autonomy",
    "autonomy_grant_id",
    "autonomy_basis",
    "action_fingerprint",
    "required_conditions",
    "missing_conditions",
    "approval_required",
    "post_execution_verification_required",
    "tool_execution_allowed",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "BLOCK",
        "NEED_APPROVAL"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_attestation_ref": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "role_grant_state": {
      "enum": [
        "GRANTED",
        "CONDITIONAL",
        "DENIED",
        "PROHIBITED"
      ]
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "declared_risk": {
      "type": "string",
      "minLength": 1
    },
    "effective_risk": {
      "oneOf": [
        {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "risk_adjusted": {
      "type": "boolean"
    },
    "minimum_autonomy": {
      "oneOf": [
        {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "autonomy_ceiling": {
      "oneOf": [
        {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "current_autonomy": {
      "oneOf": [
        {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "autonomy_grant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "autonomy_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "required_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "post_execution_verification_required": {
      "type": "boolean"
    },
    "tool_execution_allowed": {
      "type": "boolean"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}