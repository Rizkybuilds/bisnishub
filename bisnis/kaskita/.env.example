# ============================================================================
# KASKITA ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cloudflare R2 Storage (Bukti Transfer Warga)
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=kaskita-proofs
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://r2.kaskita.id

# WhatsApp Gateway (Khusus Tier Pro Komunitas)
# Tier Free menggunakan Client-Side Deep Link wa.me tanpa API key
WA_GATEWAY_PROVIDER=fonnte # fonnte / waha / official
WA_GATEWAY_API_KEY=your_wa_gateway_token

# App Host
PUBLIC_APP_URL=https://kaskita.id
