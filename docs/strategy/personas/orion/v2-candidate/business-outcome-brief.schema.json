{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bisnishub.invalid/orion/v2-candidate/business-outcome-brief.schema.json",
  "title": "ORION v2 Business Outcome Brief (BOB) Schema",
  "description": "Governed candidate schema for ORION v2 strategic handoffs to Head Engineering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "target_system",
    "target_business",
    "date",
    "repository_baseline_sha",
    "business_objective",
    "desired_outcome",
    "owner_direction",
    "scope_boundaries",
    "invariants",
    "authority_disclaimer"
  ],
  "properties": {
    "brief_id": {
      "type": "string",
      "pattern": "^BOB-[A-Z0-9]+-[0-9]{8}-[0-9]{2,}$"
    },
    "target_system": {
      "type": "string",
      "enum": [
        "mgbos",
        "teestock",
        "jarvis",
        "repository-engineering",
        "shared"
      ]
    },
    "target_business": {
      "type": "string",
      "enum": [
        "TeeStock",
        "MultiGraph",
        "MGBOS",
        "Shared"
      ]
    },
    "date": {
      "type": "string"
    },
    "repository_baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "business_objective": {
      "type": "object",
      "required": [
        "customer_problem",
        "commercial_necessity"
      ],
      "additionalProperties": false,
      "properties": {
        "customer_problem": {
          "type": "string",
          "minLength": 1
        },
        "commercial_necessity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "desired_outcome": {
      "type": "object",
      "required": [
        "measurable_metrics",
        "expected_founder_impact"
      ],
      "additionalProperties": false,
      "properties": {
        "measurable_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "expected_founder_impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner_direction": {
      "type": "object",
      "required": [
        "decision_reference",
        "confirmation_status"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_reference": {
          "type": "string"
        },
        "confirmation_status": {
          "type": "string",
          "enum": [
            "OWNER_ACCEPTED",
            "PROPOSED_FOR_FEASIBILITY"
          ]
        }
      }
    },
    "customer_experience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_user_journey": {
          "type": "string"
        },
        "visible_acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operational_acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope_boundaries": {
      "type": "object",
      "required": [
        "in_scope",
        "out_of_scope",
        "non_goals"
      ],
      "additionalProperties": false,
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "invariants": {
      "type": "object",
      "required": [
        "financial_constraints",
        "security_boundaries",
        "operational_constraints"
      ],
      "additionalProperties": false,
      "properties": {
        "financial_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operational_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority_rationale": {
      "type": "string"
    },
    "authority_disclaimer": {
      "type": "object",
      "required": [
        "implementation_authority",
        "merge_deploy_production_authority"
      ],
      "additionalProperties": false,
      "properties": {
        "implementation_authority": {
          "type": "string",
          "const": "NONE_FROM_THIS_BRIEF"
        },
        "merge_deploy_production_authority": {
          "type": "string",
          "const": "NONE_FROM_THIS_BRIEF"
        }
      }
    }
  }
}
